# Platform API (platform/main.ts). Copy to .env for local use; never commit real secrets.
# Unprivileged login role for the API (member of modus_app; not superuser, owns nothing).
DATABASE_URL=postgres://modus_api:modus-api-local-only@127.0.0.1:5432/modus
# Schema owner for migrations, provisioning and the demo seed.
MIGRATION_DATABASE_URL=postgres://modus:modus-local-only@127.0.0.1:5432/modus
# Authentication (ADR-0009): dev-token is for local development only and is refused
# when NODE_ENV=production. OIDC will be added once the identity provider is chosen.
MODUS_AUTH_MODE=dev-token
# At least 32 random characters, e.g. `openssl rand -base64 48`
MODUS_AUTH_SECRET=
PLATFORM_PORT=3100
# Server used by integration tests; each test file creates and drops its own database
TEST_DATABASE_URL=postgres://modus:modus-local-only@127.0.0.1:5432/postgres
