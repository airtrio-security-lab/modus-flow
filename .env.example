# Platform API (platform/main.ts). Copy to .env for local use; never commit real secrets.
DATABASE_URL=postgres://modus:modus-local-only@127.0.0.1:5432/modus
# At least 32 random characters, e.g. `openssl rand -base64 48`
MODUS_AUTH_SECRET=
PLATFORM_PORT=3100
# Server used by integration tests; each test file creates and drops its own database
TEST_DATABASE_URL=postgres://modus:modus-local-only@127.0.0.1:5432/postgres
